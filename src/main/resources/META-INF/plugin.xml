<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.wulfindustries.plugins.better-cucumber-js</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Better-cucumber-js</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>Alex Wulf</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Run and debug <a href="https://github.com/cucumber/cucumber-js">Cucumber.js</a> features, scenarios and
        Scenario Outline examples straight from the gutter of <code>.feature</code> files, or whole directories of
        them from the Project view.<br>
        Uses the project's own <code>@cucumber/cucumber</code> installation and configuration, and shows results
        in the IDE test runner.<br>
        Jump from a step to its JavaScript or TypeScript step definition, get warned about undefined steps and
        create step definitions for them.<br>
        Large Examples tables stay readable: rainbow columns, the column at the caret highlighted in every row,
        breadcrumbs down to the row and column, and a Scenario Inspector tool window that shows a scenario as it runs, with the values of an Examples row filled in, and compares and edits rows.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>gherkin</depends>
    <depends>JavaScript</depends>
    <depends>NodeJS</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="com.wulfindustries.plugins.run.CucumberJsConfigurationType"/>
        <runConfigurationProducer implementation="com.wulfindustries.plugins.run.CucumberJsRunConfigurationProducer"/>
        <runLineMarkerContributor language="Gherkin"
                                  implementationClass="com.wulfindustries.plugins.run.CucumberJsRunLineMarkerContributor"/>

        <annotator language="Gherkin" implementationClass="com.wulfindustries.plugins.tables.RainbowColumnsAnnotator"/>
        <editorFactoryListener implementation="com.wulfindustries.plugins.tables.CurrentColumnHighlighter"/>
        <daemon.highlightInfoFilter implementation="com.wulfindustries.plugins.tables.ExpandedScenarioHighlightFilter"/>
        <breadcrumbsInfoProvider implementation="com.wulfindustries.plugins.tables.GherkinBreadcrumbsProvider"/>
        <colorSettingsPage implementation="com.wulfindustries.plugins.tables.TableColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/CucumberJsTablesDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/CucumberJsTablesDarcula.xml"/>
        <applicationConfigurable parentId="language" instance="com.wulfindustries.plugins.tables.CucumberJsTableConfigurable"
                                 id="com.wulfindustries.plugins.tables" key="tables.settings.name"/>
        <toolWindow id="Scenario Inspector" anchor="right" secondary="true" icon="AllIcons.Actions.Preview"
                    factoryClass="com.wulfindustries.plugins.tables.ScenarioInspectorToolWindowFactory"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.cucumber.steps">
        <cucumberJvmExtensionPoint implementation="com.wulfindustries.plugins.steps.CucumberJsExtension"/>
    </extensions>

</idea-plugin>
